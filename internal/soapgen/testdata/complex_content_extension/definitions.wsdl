<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions name="Inheritance" targetNamespace="http://example.com/inherit"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://example.com/inherit">
  <wsdl:types>
    <xs:schema targetNamespace="http://example.com/inherit" elementFormDefault="qualified">
      <!-- Base request: inherited fields must be merged into derived types. -->
      <xs:complexType name="BaseRequest">
        <xs:sequence>
          <xs:element name="SessionId" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="DerivedRequest">
        <xs:complexContent>
          <xs:extension base="tns:BaseRequest">
            <xs:sequence>
              <xs:element name="Plate" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>
      <!-- Third level: exercises recursive base resolution. -->
      <xs:complexType name="GrandDerivedRequest">
        <xs:complexContent>
          <xs:extension base="tns:DerivedRequest">
            <xs:sequence>
              <xs:element name="Extra" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>
      <xs:complexType name="ResultBase">
        <xs:sequence>
          <xs:element name="Success" type="xs:boolean" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="DerivedResult">
        <xs:complexContent>
          <xs:extension base="tns:ResultBase">
            <xs:sequence>
              <xs:element name="Value" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>
      <xs:element name="DoWork">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Context" type="tns:GrandDerivedRequest" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="DoWorkResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="DoWorkResult" type="tns:DerivedResult" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="DoWorkIn">
    <wsdl:part name="parameters" element="tns:DoWork"/>
  </wsdl:message>
  <wsdl:message name="DoWorkOut">
    <wsdl:part name="parameters" element="tns:DoWorkResponse"/>
  </wsdl:message>
  <wsdl:portType name="InheritancePortType">
    <wsdl:operation name="DoWork">
      <wsdl:input message="tns:DoWorkIn"/>
      <wsdl:output message="tns:DoWorkOut"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="InheritanceBinding" type="tns:InheritancePortType">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="DoWork">
      <soap:operation soapAction="http://example.com/inherit/DoWork" style="document"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="InheritanceService">
    <wsdl:port name="InheritancePort" binding="tns:InheritanceBinding">
      <soap:address location="http://example.com/inherit"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
